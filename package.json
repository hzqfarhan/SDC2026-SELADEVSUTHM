{
  "name": "shiftatlas-3d",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts tests/*.test.mjs",
    "refresh:labour": "node scripts/refresh-labour.mjs",
    "refresh:research": "node scripts/refresh-research.mjs",
    "prebuild": "node scripts/prepare-workers.mjs && tsx scripts/export-cloud-catalogue.ts",
    "predev": "node scripts/prepare-workers.mjs && tsx scripts/export-cloud-catalogue.ts",
    "test:worker": "python -m unittest discover -s runpod -p test_*.py"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.4.0",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.13.0",
    "next": "^16.0.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
